#!/bin/sh
# pre-commit: runs on every local commit, from any tool (Claude Code, Codex, terminal).
#   1. No commit on main or master: work happens on dev; main changes only through a merged PR.
#   2. Author and committer must be the owner.
# The check lives in owner-check.sh, shared with pre-merge-commit and commit-msg.
# Enable once per clone: git config core.hooksPath .githooks (see AGENTS.md).

. "$(dirname "$0")/owner-check.sh" || exit 1
owner_check pre-commit || exit 1
exit 0
