#!/bin/sh
# commit-msg: runs on every local commit, from any tool (Claude Code, Codex, terminal).
# Adapted from PitchCraft's commit-msg hook (C:\Dev\pitchcraft-agent\.githooks\commit-msg).
#   1. Author and committer must be the owner (second line after pre-commit).
#   2. Any AI attribution is rejected (PitchCraft strips it; here the commit is refused so the
#      writer sees it and fixes the message).
#   3. The subject must be conventional: type: lowercase imperative summary, plus a body.

MSG_FILE="$1"
OWNER_EMAIL="edherdenez@gmail.com"

# The message is read in the C locale so the result does not depend on the shell's locale
# (Git for Windows' grep missed `[^[:alnum:]]*` over an emoji under UTF-8; PitchCraft QA2-05).
in_c() { LC_ALL=C "$@"; }

email_of() { git var "$1" | sed -E 's/^.*<([^>]*)>.*$/\1/'; }
AUTHOR_EMAIL=$(email_of GIT_AUTHOR_IDENT)
COMMITTER_EMAIL=$(email_of GIT_COMMITTER_IDENT)

if [ "$AUTHOR_EMAIL" != "$OWNER_EMAIL" ] || [ "$COMMITTER_EMAIL" != "$OWNER_EMAIL" ]; then
  echo "commit-msg: blocked. Author/committer must be $OWNER_EMAIL." >&2
  echo "  author:    $AUTHOR_EMAIL" >&2
  echo "  committer: $COMMITTER_EMAIL" >&2
  exit 1
fi

CONTENT=$(in_c grep -v '^#' < "$MSG_FILE")

# AI attribution, whatever the tool: trailers (Co-authored-by of anyone, Claude-Session,
# Codex-Session, Assisted-by, Generated-by), "Generated with/by <tool>" lines (an emoji before
# them counts), a Signed-off-by from a tool, and any tool's noreply address.
# Prose that merely mentions a tool is allowed.
TOOLS='claude|codex|openai|chatgpt|gpt|copilot|gemini|cursor|aider|windsurf|cody|anthropic|antigravity'
ATTRIBUTION=$(printf '%s\n' "$CONTENT" | in_c grep -i -E "^[[:space:]]*(co-authored-by|claude-session|codex-session|assisted-by|generated-by):|^[^[:alnum:]]*generated with |^[^[:alnum:]]*generated by .*($TOOLS)|^[[:space:]]*signed-off-by:.*($TOOLS)|noreply@(anthropic|openai)\.com")
if [ -n "$ATTRIBUTION" ]; then
  echo "commit-msg: blocked. AI attribution is not allowed in commit messages:" >&2
  printf '  %s\n' "$ATTRIBUTION" >&2
  exit 1
fi

SUBJECT=$(printf '%s\n' "$CONTENT" | in_c sed '/^[[:space:]]*$/d' | head -n 1)

# Merge and Revert: only the messages git writes itself, never free text.
if printf '%s\n' "$SUBJECT" | in_c grep -q -E "^Merge (branch|remote-tracking branch|tag|pull request) .+$"; then
  exit 0
fi
if printf '%s\n' "$SUBJECT" | in_c grep -q -E '^Revert ".+"$' \
  && printf '%s\n' "$CONTENT" | in_c grep -q -E '^This reverts commit [0-9a-f]{40}(, reversing changes made to [0-9a-f]{40})?\.$'; then
  exit 0
fi

# type(scope)?: lowercase imperative summary, no trailing period. Code in backticks may keep its case.
SUBJECT_WITHOUT_CODE=$(printf '%s\n' "$SUBJECT" | in_c sed -E 's/`[^`]*`//g')
if ! printf '%s\n' "$SUBJECT" | in_c grep -q -E '^(feat|fix|docs|chore|style|refactor|test|perf|ci|build)(\([a-z0-9._-]+\))?: [a-z0-9`]' \
  || printf '%s\n' "$SUBJECT_WITHOUT_CODE" | in_c grep -q '[A-Z]' \
  || printf '%s\n' "$SUBJECT" | in_c grep -q '\.$'; then
  echo "commit-msg: blocked. Subject must look like 'fix: lowercase imperative summary' (no capitals, no trailing period)." >&2
  echo "  got: $SUBJECT" >&2
  exit 1
fi

BODY_LINES=$(printf '%s\n' "$CONTENT" | in_c sed '/^[[:space:]]*$/d' | in_c sed '1d' | wc -l | tr -d ' ')
if [ "$BODY_LINES" -lt 1 ]; then
  echo "commit-msg: blocked. A body explaining what changed and why is required." >&2
  exit 1
fi

exit 0
