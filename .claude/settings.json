{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin ::*)",
      "Bash(git push --tags:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git rebase:*)",
      "Bash(git pull --rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config core.hooksPath :*)",
      "Bash(git config --unset core.hooksPath:*)",
      "Bash(git config --global core.hooksPath:*)",
      "Bash(git -c core.hooksPath:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag --delete:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin HEAD:main:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push --delete:*)",
      "PowerShell(git push origin --delete:*)",
      "PowerShell(git push origin ::*)",
      "PowerShell(git push --tags:*)",
      "PowerShell(git push --no-verify:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git pull --rebase:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git config core.hooksPath :*)",
      "PowerShell(git config --unset core.hooksPath:*)",
      "PowerShell(git config --global core.hooksPath:*)",
      "PowerShell(git -c core.hooksPath:*)",
      "PowerShell(git branch -d:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git branch --delete:*)",
      "PowerShell(git tag -d:*)",
      "PowerShell(git tag --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_guard.py\""
          }
        ]
      }
    ]
  }
}
